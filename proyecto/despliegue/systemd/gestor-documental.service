# Servicio de Gunicorn para el Sistema Gestor Documental (gestor.filosdev.com).
# Sigue el mismo patrón de los otros servicios del VPS (p. ej. cancelaciones.service):
# usuario de sistema propio, código en /opt y Gunicorn escuchando solo en 127.0.0.1.
#
# Puerto 8020: los puertos 8000, 8001 y 8010 ya los usan otras aplicaciones del servidor.
#
# Copiar a /etc/systemd/system/gestor-documental.service y ejecutar:
#   systemctl daemon-reload && systemctl enable --now gestor-documental

[Unit]
Description=Gestor Documental (Django + Gunicorn)
After=network.target mariadb.service

[Service]
User=gestordoc
Group=gestordoc
WorkingDirectory=/opt/gestor-documental/proyecto/backend
Environment=DJANGO_SETTINGS_MODULE=gestor_documental.settings_produccion
ExecStart=/opt/gestor-documental/proyecto/backend/venv/bin/gunicorn gestor_documental.wsgi:application \
    -w 3 -b 127.0.0.1:8020 --timeout 120 \
    --access-logfile - --error-logfile -
Restart=always

[Install]
WantedBy=multi-user.target
