# Copiar como /opt/gestor-documental/proyecto/backend/.env y completar.
# Este archivo de ejemplo no lleva valores reales; el .env no se sube a Git.

# Generar una clave nueva con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta

ALLOWED_HOSTS=gestor.filosdev.com
CSRF_TRUSTED_ORIGINS=https://gestor.filosdev.com
CORS_ALLOWED_ORIGINS=https://gestor.filosdev.com

# Base de datos MySQL dedicada al gestor (no comparte esquema con otras apps)
DB_ENGINE=mysql
DB_NAME=gestor_documental
DB_USER=gestor
DB_PASSWORD=cambiar-por-una-contrasena-segura
DB_HOST=127.0.0.1
DB_PORT=3306

# Si el servidor no tiene MySQL, usar SQLite (archivo produccion.sqlite3):
# DB_ENGINE=sqlite

# Poner en False solo mientras el sitio funcione sin HTTPS (antes de Certbot).
COOKIES_SEGURAS=True
